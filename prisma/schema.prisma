generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String             @id @default(uuid())
  name              String
  phone             String             @unique
  password          String
  role              Role               @default(USER)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  adminPayments     Payment[]          @relation("AdminPayments")
  payments          Payment[]          @relation("UserPayments")
  pushSubscriptions PushSubscription[]
}

model Asset {
  id                String      @id @default(uuid())
  name              String
  location          String
  dimensions        String
  description       String?
  images            String[]
  purchasePrice     Decimal     @db.Decimal(12, 2)
  currentValue      Decimal     @db.Decimal(12, 2)
  associatedUsersId String[]
  status            AssetStatus @default(ACTIVE)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  purchaseDate      DateTime    @default(now())
}

model Payment {
  id              String        @id @default(uuid())
  userId          String
  amount          Decimal       @db.Decimal(12, 2)
  proofImage      String
  status          PaymentStatus @default(PENDING)
  paymentCircle   Int
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  updatedById     String?
  updatedBy       User?         @relation("AdminPayments", fields: [updatedById], references: [id])
  user            User          @relation("UserPayments", fields: [userId], references: [id], onDelete: Cascade)
}

model Target {
  id               String   @id @default(uuid())
  year             Int      @unique
  individualTarget Decimal  @db.Decimal(12, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  numOfPayments    Int      @default(10)
  numOfMembers     Int      @default(6)
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum AssetStatus {
  ACTIVE
  SOLD
  MAINTENANCE
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}
